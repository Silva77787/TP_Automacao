				{
					"listen": "test",
					"script": {
						"exec": [
							"const expectedStatus = parseInt(pm.iterationData.get(\"expect_status\"), 10);\r",
							"const resp = pm.response.json();\r",
							"\r",
							"// Define expected messages for each status code\r",
							"const expectedMessages = {\r",
							"    201: \"User registered\",\r",
							"    400: \"All fields are required\",\r",
							"    409: \"Username or email already exists\"\r",
							"};\r",
							"\r",
							"// Test: Status code matches expected\r",
							"pm.test(`Status code is ${expectedStatus}`, function () {\r",
							"    pm.response.to.have.status(expectedStatus);\r",
							"});\r",
							"\r",
							"// Test: Response message matches expected for each status\r",
							"pm.test(\"Correct response message/explanation\", function () {\r",
							"    const expectedMessage = expectedMessages[expectedStatus];\r",
							"    if (expectedStatus === 201) {\r",
							"        pm.expect(resp.success).to.eql(expectedMessage);\r",
							"    } else {\r",
							"        pm.expect(resp.error).to.include(expectedMessage);\r",
							"    }\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
